# =============================================================================
# KaraHoca Shipping — environment
# =============================================================================
# cp .env.example .env  then fill in every value marked REQUIRED.
#
# Generate each secret separately (never reuse one across variables):
#   openssl rand -base64 48
# =============================================================================

# ---- Database ---------------------------------------------------------------
POSTGRES_DB=karahoca
POSTGRES_USER=karahoca
POSTGRES_PASSWORD=                       # REQUIRED
DB_POOL_MAX=20

# ---- Public URLs -------------------------------------------------------------
# PUBLIC_API_URL is embedded in the QR hand-off link printed for drivers, so it
# must be the externally reachable origin, not an internal container name.
PUBLIC_API_URL=https://track.karahoca.com
CORS_ORIGINS=https://panel.karahoca.com
API_PORT=4000
WEB_PORT=3000

# Build-time for the web image (NEXT_PUBLIC_* is inlined, not read at runtime).
NEXT_PUBLIC_API_URL=https://track.karahoca.com/api/v1
# Swap for a self-hosted tileserver-gl / protomaps URL when you want the map
# fully in-house; no application code changes (ADR-007).
NEXT_PUBLIC_MAP_STYLE=https://tiles.openfreemap.org/styles/liberty

# ---- Secrets -----------------------------------------------------------------
JWT_USER_SECRET=                         # REQUIRED — dispatcher tokens
JWT_DRIVER_SECRET=                       # REQUIRED — driver session tokens
# Envelope key for the per-session HMAC keys stored in session_devices.
# ROTATING THIS INVALIDATES EVERY LIVE SESSION — treat it as permanent.
INGEST_KEY_SECRET=                       # REQUIRED

# ---- Ingest policy -------------------------------------------------------------
INGEST_REQUIRE_HMAC=true                 # set false ONLY for local curl testing
INGEST_MAX_BATCH_POINTS=5000
INGEST_RATE_POINTS_PER_MIN=20000
INGEST_RATE_REQUESTS_PER_MIN=120
HMAC_SKEW_SEC=600

# ---- Session policy ------------------------------------------------------------
SESSION_CLAIM_TTL_MIN=720                # 12 h to claim a code
SESSION_MAX_LIFETIME_HOURS=72            # hard expiry safety net
DEEP_LINK_SCHEME=karahoca
# The intent:// fallback on the QR landing page names an exact package.
# Debug builds install as com.karahoca.tracker.debug (applicationIdSuffix).
DEEP_LINK_PACKAGE=com.karahoca.tracker
# Where the QR page sends a phone that does not have the app yet.
APK_DOWNLOAD_URL=

# ---- Realtime -------------------------------------------------------------------
REALTIME_FLEET_THROTTLE_MS=1000
REALTIME_MAX_BACKFILL_POINTS=2000

# ---- First-boot admin ------------------------------------------------------------
# Used once, only when the users table is empty. Remove after first boot.
ADMIN_EMAIL=dispatch@karahoca.local
ADMIN_PASSWORD=                          # min 12 chars
ADMIN_NAME=KaraHoca Admin

# ---- Standalone (edge profile) only ------------------------------------------------
API_DOMAIN=track.karahoca.com
WEB_DOMAIN=panel.karahoca.com
ACME_EMAIL=ops@karahoca.com

# ---- Backups ------------------------------------------------------------------------
BACKUP_KEEP_DAYS=14
# Hetzner Storage Box (optional off-site push)
BACKUP_SFTP_HOST=
BACKUP_SFTP_USER=
BACKUP_SFTP_PATH=/backups/karahoca

APP_VERSION=1.0.0
